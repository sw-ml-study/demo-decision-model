 "reflections": {
  "i": "you",
  "me": "you",
  "my": "your",
  "mine": "yours",
  "myself": "yourself",
  "am": "are",
  "im": "you are",
  "ive": "you have",
  "id": "you would",
  "ill": "you will",
  "you": "I",
  "your": "my",
  "yours": "mine",
  "yourself": "myself",
  "youre": "I am",
  "youve": "I have",
  "was": "were"
 },
 "recall": {
  "min_gap": 2,
  "frames": [
   "Earlier you said {all}.",
   "You mentioned before that {all}. Does that still bother you?",
   "Does that have anything to do with the fact that {all}?"
  ]
 },
 "memory": {
  "trigger": "my",
  "min_words": 3,
  "frames": [
   "Earlier you said {all}.",
   "Let's discuss further why {all}.",
   "Does that have anything to do with the fact that {all}?"
  ],
  "lead_fillers": [
   "well",
   "oh",
   "so",
   "and",
   "but",
   "um",
   "uh",
   "like",
   "anyway",
   "ok",
   "okay",
   "yeah",
   "hmm",
   "honestly"
  ]
 },
 "reflect": {
  "min_words": 3,
  "frames": [
   "Why do you say {all}?",
   "What makes you say {all}?",
   "Why do you tell me {all}?"
  ]
 },
 "generic": [
  {
   "pattern": "* i dont *",
   "replies": [
    "Don't you really {2}?",
    "Why don't you {2}?",
    "Do you wish to be able to {2}?"
   ]
  },
  {
   "pattern": "* i cant *",
   "replies": [
    "How do you know you can't {2}?",
    "Have you tried?",
    "Perhaps you could {2} now."
   ]
  },
  {
   "pattern": "* i am *",
   "replies": [
    "Is it because you are {2} that you came to me?",
    "How long have you been {2}?",
    "Do you believe it is normal to be {2}?"
   ]
  },
  {
   "pattern": "* because *",
   "replies": [
    "Is that the real reason?",
    "Don't any other reasons come to mind?",
    "Does that reason seem to explain anything else?"
   ]
  },
  {
   "pattern": "* i think *",
   "replies": [
    "Do you really think so?",
    "But you are not sure {2}?",
    "Why do you think {2}?"
   ]
  }
 ],
 "rules": {
  "FAMILY": [
   {
    "find": [
     "mother",
     "father",
     "mom",
     "dad",
     "mum",
     "sister",
     "brother",
     "parents",
