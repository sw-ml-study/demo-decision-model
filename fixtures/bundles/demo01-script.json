 "nouls": {
  "deflect": {
   "noul": "question",
   "threshold": 0.5,
   "labels": [
    "QUESTION"
   ],
   "frames": [
    "We were discussing you, not me.",
    "I ask the questions here.",
    "Why do you ask?",
    "I'm not here to answer questions. What do you think?",
    "Does that question interest you?",
    "What answer would please you most?"
   ],
   "threshold_without_mark": 0.9
  },
  "sentiment": [
   {
    "noul": "negative",
    "threshold": 0.6,
    "frames": [
     "You seem upset that {all}.",
     "It sounds hard that {all}. Tell me more.",
     "How does it feel that {all}?"
    ]
   },
   {
    "noul": "positive",
    "threshold": 0.6,
    "frames": [
     "It is good to hear that {all}. How does that make you feel?",
     "You seem pleased that {all}.",
     "That sounds good. What else is on your mind?"
    ]
   }
  ]
 }
