     "grandmother",
     "grandfather",
     "girlfriend",
     "boyfriend",
     "family",
     "aunt",
     "uncle"
    ],
    "replies": [
     "Tell me more about your {w}.",
     "How do you get along with your {w}?",
     "Does your {w} know how you feel?",
     "Who else in your family comes to mind when you think of your {w}?"
    ]
   }
  ],
  "FEELING": [
   {
    "pattern": "* i feel *",
    "replies": [
     "Do you often feel {2}?",
     "What makes you feel {2}?",
     "Tell me more about feeling {2}."
    ]
   },
   {
    "pattern": "* i am *",
    "replies": [
     "How long have you been {2}?",
     "Do you believe it is normal to be {2}?",
     "Do you enjoy being {2}?"
    ]
   },
   {
    "pattern": "* i have been *",
    "replies": [
     "How long have you been {2}?",
     "What do you think is behind being {2}?"
    ]
   }
  ],
  "DESIRE": [
   {
    "pattern": "* i want *",
    "replies": [
     "What would it mean to you if you got {2}?",
     "Why do you want {2}?",
     "Suppose you got {2} soon."
    ]
   },
   {
    "pattern": "* i need *",
    "replies": [
     "Why do you need {2}?",
     "Would it really help you to get {2}?",
     "What if you never got {2}?"
    ]
   },
   {
    "pattern": "* i wish *",
    "replies": [
     "Why do you wish {2}?",
     "What would change if {2}?"
    ]
   }
  ],
  "DREAM": [
   {
    "pattern": "* i dreamt *",
    "replies": [
     "Really, {2}?",
     "Have you ever fantasized {2} while you were awake?"
    ]
   },
   {
    "pattern": "* i dreamed *",
    "replies": [
     "Really, {2}?",
     "Have you ever fantasized {2} while you were awake?"
    ]
   },
   {
    "pattern": "* dream about *",
    "replies": [
     "What does dreaming about {2} suggest to you?",
     "Do you often dream about {2}?"
    ]
   }
  ],
  "QUESTION": [
   {
    "pattern": "* are you *",
    "replies": [
     "Why are you interested in whether I am {2} or not?",
     "Would you prefer if I weren't {2}?"
    ]
   },
   {
    "pattern": "* can you *",
    "replies": [
     "You believe I can {2}, don't you?",
     "Whether or not I can {2} depends on you more than on me."
    ]
   },
   {
    "pattern": "* why dont you *",
    "replies": [
     "Do you believe I don't {2}?",
     "Perhaps I will {2} in good time."
    ]
   }
  ],
  "ALWAYS": [
   {
    "pattern": "* everyone *",
    "replies": [
     "Really, everyone?",
     "Surely not everyone.",
     "Can you think of anyone in particular?"
    ]
   },
   {
    "pattern": "* everybody *",
    "replies": [
     "Really, everybody?",
     "Surely not everybody."
    ]
   },
   {
    "pattern": "* nobody *",
    "replies": [
     "Really, nobody?",
     "Surely someone does."
    ]
   },
   {
    "pattern": "* always *",
    "replies": [
     "Can you think of a specific example?",
     "When?",
     "Really, always?"
    ]
   }
  ],
  "HOSTILE": [
   {
    "pattern": "* you are *",
    "replies": [
     "What makes you think I am {2}?",
     "Does it please you to believe I am {2}?"
