#!/bin/sh
# Gate check for every literate document under docs/literate/: (1) each :tangle block, concatenated in document order with one blank line between blocks of the same target, must equal the committed file byte for byte (awk tangle, the rule org-babel-tangle applies; cross-checked with org-babel-tangle when Emacs is available); (2) every runnable primer block (:tangle no :exports both) must print exactly the #+RESULTS: recorded beneath it; (3) when Emacs is available, each document's published HTML must equal a fresh batch export.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
work="$repo_root/tmp/tangle.$$"
rm -rf "$work"; mkdir -p "$work"
trap 'rm -rf "$work"' EXIT HUP INT TERM

emacs=${EMACS:-}
[ -n "$emacs" ] || ! command -v emacs >/dev/null 2>&1 || emacs=emacs
[ -n "$emacs" ] || [ ! -x /Applications/Emacs.app/Contents/MacOS/Emacs ] || emacs=/Applications/Emacs.app/Contents/MacOS/Emacs

status=0
docs=$(find "$repo_root/docs/literate" -maxdepth 1 -name '*.org' | sort)
[ -n "$docs" ] || { echo "no literate documents found" >&2; exit 1; }

for org in $docs; do
    name=$(basename "$org" .org)
    # The first document published keeps its original output name.
    case "$name" in
        demo-decision-model) html="$repo_root/docs/literate/literate.html" ;;
        *) html="$repo_root/docs/literate/$name.html" ;;
    esac
    out="$work/$name"
    mkdir -p "$out/awk" "$out/run"

    awk -v out="$out/awk" '
    /^#\+begin_src / {
        target = ""
        for (i = 2; i <= NF; i++) if ($i == ":tangle") target = $(i + 1)
        if (target != "" && target != "no") {
            sub(/^\.\.\/\.\.\//, "", target)
            file = out "/" target
            dir = file; sub(/\/[^\/]*$/, "", dir)
            system("mkdir -p \"" dir "\"")
            if (file in seen) printf "\n" >> file
            seen[file] = 1
            inblock = 1
            next
        }
    }
    /^#\+end_src/ { inblock = 0; next }
    inblock { print >> file }
    ' "$org"

    count=0
    for tangled in $(cd "$out/awk" && find . -type f | sort); do
        rel=${tangled#./}
        count=$((count + 1))
        if ! cmp -s "$out/awk/$rel" "$repo_root/$rel"; then
            echo "tangle drift: $name.org does not reproduce $rel" >&2
            diff "$repo_root/$rel" "$out/awk/$rel" | head -20 >&2
            status=1
        fi
    done
    [ "$count" -gt 0 ] || { echo "no tangle targets found in $name.org" >&2; status=1; }

    # The primer blocks: run each in a fresh interpreter, from the repository
    # root so that a primer may include the library it is describing, and
    # compare with the recorded result.
    python3 - "$org" "$mlpl" "$out/run" "$repo_root" <<'PY' || status=1
import re, subprocess, sys, pathlib, tempfile
org, mlpl, _work, root = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
# Outside the repository on purpose. An include resolves relative to the file
# that wrote it, and only falls back to --source-dir when the file lies outside
# it: a primer kept in tmp/ would look for tmp/lib/ and fail, while one kept
# elsewhere resolves "lib/decision.mlpl" against the repository, which is what
# the block shows a reader typing.
work = pathlib.Path(tempfile.mkdtemp(prefix="mlpl-primer-"))
text = pathlib.Path(org).read_text()
blocks = re.findall(r"#\+begin_src mlpl :tangle no :exports both\n(.*?)\n#\+end_src\n\n#\+RESULTS:\n(.*?)\n\n", text, re.S)
name = pathlib.Path(org).stem
if not blocks:
    # A document may be all tangled source: the program it tangles is run by
    # its own gate check, which is a stronger claim than a recorded block.
    print(f"literate: {name}.org has no primer blocks; its tangled source is checked instead")
    sys.exit(0)
bad = 0
for i, (body, result) in enumerate(blocks, 1):
    if result.startswith("#+begin_example"):
        expected = result.split("\n")[1:-1]
    else:
        expected = [l[2:] if l.startswith(": ") else l[1:] for l in result.split("\n")]
    path = work / f"primer-{i}.mlpl"
    path.write_text(body + "\n")
    run = subprocess.run([mlpl, "--source-dir", root, str(path)], capture_output=True, text=True, timeout=600, cwd=root)
    got = run.stdout.rstrip("\n").split("\n")
    if run.returncode != 0 or got != expected:
        bad += 1
        print(f"{name}.org primer block {i} does not reproduce its recorded result", file=sys.stderr)
        print("expected:", "\n".join(expected), sep="\n", file=sys.stderr)
        print("got:", run.stdout + run.stderr, sep="\n", file=sys.stderr)
print(f"literate: {name}.org, {len(blocks)} primer blocks reproduce their recorded results" if not bad else f"literate: {name}.org, {bad} primer blocks drifted")
sys.exit(1 if bad else 0)
PY

    if [ -n "$emacs" ]; then
        mkdir -p "$out/emacs/docs/literate"
        cp "$org" "$out/emacs/docs/literate/$name.org"
        for tangled in $(cd "$out/awk" && find . -type f | sort); do
            mkdir -p "$out/emacs/$(dirname "${tangled#./}")"
        done
        if "$emacs" --batch -l org --eval "(progn (add-to-list 'org-babel-tangle-lang-exts '(\"mlpl\" . \"mlpl\")) (org-babel-tangle-file \"$out/emacs/docs/literate/$name.org\"))" >/dev/null 2>&1; then
            for tangled in $(cd "$out/awk" && find . -type f | sort); do
                rel=${tangled#./}
                cmp -s "$out/emacs/$rel" "$repo_root/$rel" || { echo "org-babel-tangle differs from the committed $rel" >&2; status=1; }
            done
            echo "tangle: $name.org reproduces $count file(s) by awk and by org-babel-tangle"
        else
            echo "tangle: $name.org reproduces $count file(s) by awk; org-babel-tangle failed to run" >&2
            status=1
        fi
        # Org's HTML export numbers headline anchors with random org1234abc ids, so the comparison masks them.
        "$repo_root/scripts/publish-literate" "$org" "$out/fresh.html" >/dev/null
        sed -E 's/org[0-9a-f]{7}/orgID/g' "$out/fresh.html" > "$out/fresh.masked"
        sed -E 's/org[0-9a-f]{7}/orgID/g' "$html" > "$out/committed.masked" 2>/dev/null || : > "$out/committed.masked"
        cmp -s "$out/fresh.masked" "$out/committed.masked" || { echo "${html#"$repo_root/"} is stale; run just literate" >&2; status=1; }
    else
        echo "tangle: $name.org reproduces $count file(s) by awk (no Emacs found to cross-check the tangle or the HTML export)"
    fi
done

[ "$status" -eq 0 ] && echo "PASS literate documents: tangle parity, primer results, and export"
exit "$status"
