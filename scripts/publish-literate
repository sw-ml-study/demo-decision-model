#!/bin/sh
# Export a literate document to HTML with Emacs in batch mode (nothing is evaluated: the header says :eval no-export; no timestamp, so the output is stable). With no arguments, exports every docs/literate/*.org to its published name. usage: publish-literate [ORG [OUT]]
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
emacs=${EMACS:-}
[ -n "$emacs" ] || ! command -v emacs >/dev/null 2>&1 || emacs=emacs
[ -n "$emacs" ] || [ ! -x /Applications/Emacs.app/Contents/MacOS/Emacs ] || emacs=/Applications/Emacs.app/Contents/MacOS/Emacs
[ -n "$emacs" ] || { echo "no Emacs found (set EMACS to its path)" >&2; exit 1; }
# sw-MLPL's Emacs support, for the MLPL major mode htmlize colours from.
elisp=${MLPL_ELISP:-$repo_root/../sw-mlpl/elisp}

work="$repo_root/tmp/publish-literate.$$"
rm -rf "$work"; mkdir -p "$work"
trap 'rm -rf "$work"' EXIT HUP INT TERM

# The first document published keeps its original output name.
published_name() {
    case "$(basename "$1" .org)" in
        demo-decision-model) echo "$repo_root/docs/literate/literate.html" ;;
        *) echo "$repo_root/docs/literate/$(basename "$1" .org).html" ;;
    esac
}

export_one() {
    org=$1
    out=$2
    name=$(basename "$org" .org)
    cp "$org" "$work/$name.org"
    "$emacs" -Q --batch -l "$repo_root/scripts/publish-literate.el" "$work/$name.org" "$elisp" >/dev/null 2>&1 || { echo "org-html-export-to-html failed for $name.org" >&2; exit 1; }
    [ -s "$work/$name.html" ] || { echo "export of $name.org wrote nothing" >&2; exit 1; }
    cp "$work/$name.html" "$out"
    echo "wrote $out ($(wc -c < "$out" | tr -d ' ') bytes)"
}

if [ "$#" -eq 0 ]; then
    for org in "$repo_root"/docs/literate/*.org; do
        export_one "$org" "$(published_name "$org")"
    done
else
    org=$1
    case "$org" in
        *.org) ;;
        *) org="$repo_root/docs/literate/demo-decision-model.org"; set -- "$org" "$1" ;;
    esac
    export_one "$org" "${2:-$(published_name "$org")}"
fi
